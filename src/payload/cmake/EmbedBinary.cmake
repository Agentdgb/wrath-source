# EmbedBinary.cmake — emit a .cpp file with a constexpr uint8_t[] byte array
# from an arbitrary input file. Used for fonts + HookBridge.class + .vmap blobs
# when they are produced by side tools instead of hand-checked-in.
#
# dt_embed_binary(<in> <out.cpp> <c_array_name>)
function(dt_embed_binary IN OUT NAME)
    file(READ "${IN}" HEX HEX)
    string(LENGTH "${HEX}" LEN)
    math(EXPR NBYTES "${LEN} / 2")

    set(BODY "// Auto-generated by dt_embed_binary — do not edit\n")
    string(APPEND BODY "#include <cstdint>\n#include <cstddef>\n")
    string(APPEND BODY "namespace dt::generated {\n")
    string(APPEND BODY "constexpr std::size_t ${NAME}_size = ${NBYTES};\n")
    string(APPEND BODY "constexpr std::uint8_t ${NAME}[] = {\n    ")

    set(COL 0)
    string(REGEX MATCHALL "[0-9a-f][0-9a-f]" BYTES "${HEX}")
    foreach(B ${BYTES})
        string(APPEND BODY "0x${B},")
        math(EXPR COL "${COL} + 1")
        if (COL EQUAL 16)
            string(APPEND BODY "\n    ")
            set(COL 0)
        endif()
    endforeach()

    string(APPEND BODY "\n};\n} // namespace dt::generated\n")
    file(WRITE "${OUT}" "${BODY}")
endfunction()
